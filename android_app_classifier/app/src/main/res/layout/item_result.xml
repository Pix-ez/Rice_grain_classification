<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/rankTextView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="#1"
            android:gravity="center"
            android:background="@drawable/shape_circle_gray"
            android:backgroundTint="#F5F5F5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:layout_marginEnd="12dp"/>
        <!-- Note: If shape_circle_gray is missing, remove background attribute, it will still look okay -->

        <TextView
            android:id="@+id/classNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Basmati"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/probabilityTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="98.5%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/probabilityProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"

        android:progressTint="#4CAF50"
        android:max="100"
        android:progress="98"/>
    <!-- Note: If custom_progress_bg is missing, remove progressDrawable, default works fine -->

</LinearLayout>